# Extend the already installed capture sandbox; keep its browsers and data contract.
FROM email-ghost:local
USER root
RUN python -m pip install --no-cache-dir torch==2.6.0 --index-url https://download.pytorch.org/whl/cpu
RUN python -m pip install --no-cache-dir transformers==4.57.6 accelerate==1.12.0 sentencepiece==0.2.1
RUN python -m pip install --no-cache-dir protobuf==5.29.5
USER ghost
