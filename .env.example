# Copy to .env when default ports are already occupied.
GHOST_HTTP_PORT=8030
GHOST_SMTP_PUBLISH_PORT=1025

# The phone the gmail-android profile is shot on. Match your own phone: its
# CSS width, pixel density, and font-size setting in percent (Gmail Android
# scales email text by it).
GHOST_PHONE_WIDTH=412
GHOST_PHONE_SCALE=2.625
GHOST_PHONE_TEXT_ZOOM=100
# Gmail's frame around the message, and a weight shift for phones that draw
# the system face lighter than declared (-100: 400 shows as Roboto Light).
GHOST_PHONE_MARGIN=16
GHOST_PHONE_WEIGHT_SHIFT=0
